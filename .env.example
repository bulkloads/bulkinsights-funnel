# Copy to .env.local for local development. Vercel holds the deployed values.

# Origin of the Insights app, which owns the WorkOS handoff. Every Sign in /
# Sign up control on this site points at `<origin>/api/auth/sign-in` and
# `/api/auth/sign-up`, and the plan cards hand it a `next` of `/upgrade?...`.
#
# Optional. Unset or blank falls back to the production origin below, which is
# what a production build wants; set it to point a preview build of this funnel
# at a preview deployment of Insights.
#
# NEXT_PUBLIC_ means BUILD TIME. The value is inlined into the bundle when
# `next build` runs, so changing it in the Vercel dashboard does nothing on its
# own -- the project has to be redeployed for the new value to take effect.
#
# No trailing slash needed; one is stripped either way.
NEXT_PUBLIC_INSIGHTS_URL=https://insights.bulkloads.com
